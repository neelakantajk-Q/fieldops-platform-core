<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:background="@color/fo_bg"
        android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/header_bg"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="22dp" android:paddingBottom="20dp">

            <ImageView
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/brand_mark" android:scaleType="fitCenter"
                android:contentDescription="Quantum FieldOps" />

            <LinearLayout
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvUser"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" android:textSize="17sp" android:textStyle="bold"
                    android:textColor="@color/fo_white" />

                <TextView
                    android:id="@+id/tvHub"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" android:textSize="12sp" android:textColor="#C7F9D9" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Zone / transit -->
            <LinearLayout
                style="@style/FoCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvZone"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Zone: —" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/fo_text" android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/tvToday"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Today: —" android:textSize="12sp"
                    android:textColor="@color/fo_text" android:lineSpacingExtra="3dp"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPendingProof"
                style="@style/FoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="COMPLETE CHECKOUT PHOTO"
                android:visibility="gone"
                android:backgroundTint="@color/fo_danger" />

            <!-- Attendance -->
            <LinearLayout
                style="@style/FoCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="ATTENDANCE"
                    style="@style/FoSectionLabel" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCheckIn"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="CHECK IN" android:backgroundTint="@color/fo_green" />

                    <Button
                        android:id="@+id/btnCheckOut"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="CHECK OUT" android:backgroundTint="@color/fo_danger" />
                </LinearLayout>
            </LinearLayout>

            <!-- Jobs -->
            <LinearLayout
                style="@style/FoCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="JOB CARD"
                    style="@style/FoSectionLabel" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStartJob"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="START JOB" android:backgroundTint="@color/fo_lime" />

                    <Button
                        android:id="@+id/btnEndJob"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="END JOB" android:backgroundTint="@color/fo_green_dark" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnHoldJob"
                    style="@style/FoButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="HOLD JOB"
                    android:backgroundTint="@color/fo_warning" />
            </LinearLayout>

            <!-- Team & performance -->
            <LinearLayout
                style="@style/FoCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="TEAM &amp; PERFORMANCE"
                    style="@style/FoSectionLabel" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTeam"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="TEAM" android:backgroundTint="@color/fo_lime" />

                    <Button
                        android:id="@+id/btnPerformance"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="HUB &amp; PEER" android:backgroundTint="@color/fo_ink" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tools -->
            <LinearLayout
                style="@style/FoCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="FIELD OPERATIONS"
                    style="@style/FoSectionLabel" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBubble"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="FIELD BUBBLES" android:textColor="@color/fo_on_green"
                        android:backgroundTint="@color/fo_wa_green" />

                    <Button
                        android:id="@+id/btnGeo"
                        style="@style/FoButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="GEOFENCE" android:backgroundTint="@color/fo_green" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDealerVisit"
                    style="@style/FoButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="DEALER VISIT"
                    android:backgroundTint="@color/fo_lime" />

                <Button
                    android:id="@+id/btnCapture"
                    style="@style/FoButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="CAPTURE PROOF"
                    android:backgroundTint="@color/fo_warning" />

                <Button
                    android:id="@+id/btnPortal"
                    style="@style/FoButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="OPEN APP"
                    android:backgroundTint="@color/fo_ink" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                style="@style/FoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SIGN OUT" android:backgroundTint="@color/fo_muted" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textSize="11sp" android:textColor="@color/fo_text"
                android:paddingTop="14dp" android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
